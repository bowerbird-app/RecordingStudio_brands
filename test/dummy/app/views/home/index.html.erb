<% dummy_page_nav(title: "Brands demo", subtitle: "Workspaces and folders each hold as many brands as you like.", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">

  <% if @brand_parents.any? %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <% @brand_parents.each do |parent| %>
        <%= render FlatPack::List::Item.new(
          href: recording_studio_brands.recording_brands_path(parent),
          hover: true,
          trailing: render(FlatPack::Badge::Component.new(text: brand_mount_label(parent)))
        ) do %>
          <p class="font-medium"><%= parent.name %></p>
          <p class="text-sm text-(--surface-muted-content-color)"><%= parent.type_label %></p>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing to show yet",
      description: "Ask someone to invite you to a workspace."
    ) %>
  <% end %>
</div>
