<% dummy_page_nav(title: "Config", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Config",
    subtitle: "Point the screens at the host's sign-in, then choose one or many on each parent.",
    variant: :h1
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioBrands.configure do |config|
        config.authentication_method = :authenticate_user!
        config.current_actor_method = :current_user
      end

      # One brand on this parent.
      include RecordingStudio::Capabilities::Brand.to(allows: :one)

      # A list of brands on this parent.
      include RecordingStudio::Capabilities::Brand.to(allows: :many)
    CODE
  ) %>
</div>
