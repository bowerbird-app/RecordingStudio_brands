<% dummy_page_nav(title: "Methods", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "The host opts in, then saves a brand with record and revise.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Brand.to",
    subtitle: "RecordingStudio::Capabilities::Brand.to(allows:)"
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # :one keeps a single brand. :many keeps a list.
      # Anything else fails when the parent class loads.
      include RecordingStudio::Capabilities::Brand.to(allows: :one)
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "record and revise",
    subtitle: "parent_recording.record and parent_recording.revise"
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # Pass parent_recording so a non-root parent stays the parent.
      brand_recording = parent_recording.record(
        RecordingStudioBrands::Brand,
        parent_recording: parent_recording,
        actor: current_user
      ) { |brand| brand.name = "Acme Coffee" }

      parent_recording.revise(brand_recording, actor: current_user) do |brand|
        brand.tagline = "Roasted for the launch"
      end
    CODE
  ) %>
</div>
