<div class="mx-auto flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @brand.name,
    subtitle: @brand.tagline.presence || @brand.slug,
    variant: :h1
  ) do |page_title| %>
    <% page_title.slot do %>
      <%= render FlatPack::Button::Component.new(
        text: t("recording_studio.brands.actions.edit_brand"),
        style: :secondary,
        href: edit_admin_brand_path(@brand_recording)
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::List::Component.new(divider: true, spacing: :compact, class: "max-w-2xl") do %>
    <%= render FlatPack::List::Item.new(trailing: @brand.slug) do %>
      <%= t("recording_studio.brands.labels.slug") %>
    <% end %>
    <%= render FlatPack::List::Item.new(
      trailing: (@brand.active? ? t("recording_studio.brands.labels.active_yes") : t("recording_studio.brands.labels.active_no"))
    ) do %>
      <%= t("recording_studio.brands.labels.active") %>
    <% end %>
    <% if @brand.website_url.present? %>
      <%= render FlatPack::List::Item.new(trailing: @brand.website_url) do %>
        <%= t("recording_studio.brands.labels.website") %>
      <% end %>
    <% end %>
    <% if @brand.description.present? %>
      <%= render FlatPack::List::Item.new do %>
        <%= render FlatPack::Content::Component.new do %>
          <p class="text-sm font-medium"><%= t("recording_studio.brands.labels.description") %></p>
          <p class="mt-1 whitespace-pre-wrap text-sm"><%= @brand.description %></p>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
