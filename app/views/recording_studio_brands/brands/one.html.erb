<% recording_studio_page_nav(title: t("recording_studio.brands.titles.brand")) %>

<% if @brand_recording %>
  <%= render "recording_studio_brands/brands/brand", brand_recording: @brand_recording, logo: @logo %>
<% else %>
  <% editable = can_edit?(@parent) %>

  <%= render FlatPack::PageTitle::Component.new(title: t("recording_studio.brands.titles.brand"), subtitle: @parent.name) %>

  <%= render FlatPack::EmptyState::Component.new(
    title: t("recording_studio.brands.empty.no_brand_title"),
    description: (t("recording_studio.brands.empty.no_brand_description", name: @parent.name) if editable)
  ) do |empty| %>
    <% if editable %>
      <% empty.slot do %>
        <%= render FlatPack::Button::Component.new(text: t("recording_studio.brands.actions.add_brand"), style: :primary, href: new_recording_brand_path(@parent)) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
