<% recording_studio_page_nav(title: "Brands") %>

<%= render FlatPack::PageTitle::Component.new(title: "Brands", subtitle: @parent.name) do |title| %>
  <% if can_edit?(@parent) %>
    <% title.slot do %>
      <%= render FlatPack::Button::Component.new(text: "Add brand", style: :primary, href: new_recording_brand_path(@parent)) %>
    <% end %>
  <% end %>
<% end %>

<% if @brand_recordings.any? %>
  <%= render "recording_studio_brands/brands/list", brand_recordings: @brand_recordings, logos: @logos %>
<% else %>
  <%= render FlatPack::EmptyState::Component.new(title: "No brands yet", description: "Add the first one to get going.") %>
<% end %>
