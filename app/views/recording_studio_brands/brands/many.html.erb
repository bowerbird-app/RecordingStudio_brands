<% recording_studio_page_nav(title: t("recording_studio.brands.titles.brands")) %>

<%= render FlatPack::PageTitle::Component.new(
  title: t("recording_studio.brands.titles.brands"),
  subtitle: t("recording_studio.brands.many.subtitle")
) do |title| %>
  <% if can_edit?(@parent) %>
    <% title.slot do %>
      <%= render FlatPack::Button::Component.new(text: t("recording_studio.brands.actions.add_brand_plus"), style: :primary, href: new_recording_brand_path(@parent)) %>
    <% end %>
  <% end %>
<% end %>

<%= render "recording_studio_brands/brands/list_frame" do %>
  <% if @brand_recordings.any? %>
    <%= render "recording_studio_brands/brands/list", brand_recordings: @brand_recordings %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: t("recording_studio.brands.empty.no_brands_title"),
      description: t("recording_studio.brands.empty.no_brands_description")
    ) %>
  <% end %>
<% end %>
