<% content_for :title, t("recording_studio.brands.titles.brands") %>
<% content_for :subtitle, t("recording_studio.brands.many.subtitle") %>
<% if can_edit?(@parent) %>
  <% register_page_nav t("recording_studio.brands.actions.add_brand_plus"), new_recording_brand_path(@parent), role: :primary %>
<% end %>

<%= render "recording_studio_brands/brands/list_frame" do %>
  <% if @brand_recordings.any? %>
    <%= render "recording_studio_brands/brands/list", brand_recordings: @brand_recordings %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: t("recording_studio.brands.empty.no_brands_title"),
      description: t("recording_studio.brands.empty.no_brands_description")
    ) %>
  <% end %>
<% end %>
