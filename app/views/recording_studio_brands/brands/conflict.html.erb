<% recording_studio_page_nav(title: t("recording_studio.brands.titles.brands")) %>
<% type = @parent.type_label.downcase %>

<%= render FlatPack::PageTitle::Component.new(title: t("recording_studio.brands.titles.brands"), subtitle: @parent.name) %>

<%= render FlatPack::Alert::Component.new(
  title: t("recording_studio.brands.conflict.title", type:),
  description: t("recording_studio.brands.conflict.description", type:),
  style: :warning,
  class: "mb-6"
) %>

<%= render "recording_studio_brands/brands/list_frame" do %>
  <%= render "recording_studio_brands/brands/list", brand_recordings: @brand_recordings %>
<% end %>
