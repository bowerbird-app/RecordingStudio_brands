<% recording_studio_page_nav(title: "Brands") %>
<% type = @parent.type_label.downcase %>

<%= render FlatPack::PageTitle::Component.new(title: "Brands", subtitle: @parent.name) %>

<%= render FlatPack::Alert::Component.new(
  title: "This #{type} has more than one brand",
  description: "A #{type} holds just one. You can still open and edit each brand below.",
  style: :warning,
  class: "mb-6"
) %>

<%= render "recording_studio_brands/brands/list_frame" do %>
  <%= render "recording_studio_brands/brands/list", brand_recordings: @brand_recordings, logos: @logos %>
<% end %>
