<% recording_studio_page_nav(title: t("recording_studio.brands.titles.edit_brand"), page_nav_anchor_url: brand_home_path(@brand_recording)) %>

<%= render FlatPack::PageTitle::Component.new(title: t("recording_studio.brands.titles.edit_brand"), subtitle: @brand_recording.recordable.name) %>

<%= render "recording_studio_brands/brands/logo_button",
      brand_recording: @brand_recording,
      brand: @brand_recording.recordable,
      logo: RecordingStudioBrands::Logo.recording_for(@brand_recording) %>

<%= render "recording_studio_brands/brands/form", brand: @brand, url: brand_path(@brand_recording), method: :patch %>
